pipeline {
    agent any
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE = "yashraj0409/meditrack"
        IMAGE_TAG = "${BUILD_NUMBER}"
        NAMESPACE = "healthcare"
    }
    stages {
        stage('Checkout') {
            steps {
                echo "🏥 MediTrack DevSecOps Pipeline Starting..."
                checkout scm
                sh "mkdir -p security-reports"
            }
        }
        stage('Install & Audit Dependencies') {
            steps {
                echo "🔍 Running dependency security audit..."
                sh 'npm install'
                sh 'npm audit --audit-level=moderate 2>&1 | tee security-reports/npm-audit.txt || true'
                sh 'cat security-reports/npm-audit.txt'
            }
        }
        stage('Run Tests') {
            steps {
                sh 'npm test'
            }
        }
        stage('Docker Build') {
            steps {
                echo "🐳 Building MediTrack secure image..."
                sh "docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} ."
            }
        }
        stage('Trivy Vulnerability Scan') {
            steps {
                echo "🛡️ Scanning for CVEs with Trivy..."
                sh """
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      --output security-reports/trivy-report.txt \
                      ${DOCKER_IMAGE}:${IMAGE_TAG}
                    echo "--- Trivy Scan Results ---"
                    cat security-reports/trivy-report.txt
                """
            }
        }
        stage('Security Gate') {
            steps {
                echo "🚨 Evaluating security gate..."
                script {
                    def trivyOutput = sh(
                        script: "trivy image --severity CRITICAL --exit-code 0 --format json ${DOCKER_IMAGE}:${IMAGE_TAG} 2>/dev/null | python3 -c \"import json,sys; data=json.load(sys.stdin); vulns=[v for r in (data.get('Results') or []) for v in (r.get('Vulnerabilities') or []) if v.get('Severity')=='CRITICAL']; print(len(vulns))\" 2>/dev/null || echo '0'",
                        returnStdout: true
                    ).trim()
                    def count = trivyOutput.isInteger() ? trivyOutput.toInteger() : 0
                    echo "🔴 CRITICAL CVEs found: ${count}"
                    if (count > 20) {
                        error("🚫 SECURITY GATE BLOCKED: ${count} CRITICAL CVEs exceed threshold!")
                    } else {
                        echo "✅ Security gate PASSED! ${count} CRITICAL CVEs (within threshold)"
                    }
                }
            }
        }
        stage('Docker Push') {
            steps {
                sh "echo ${DOCKERHUB_CREDENTIALS_PSW} | docker login -u ${DOCKERHUB_CREDENTIALS_USR} --password-stdin"
                sh "docker push ${DOCKER_IMAGE}:${IMAGE_TAG}"
                sh "docker tag ${DOCKER_IMAGE}:${IMAGE_TAG} ${DOCKER_IMAGE}:secure-latest"
                sh "docker push ${DOCKER_IMAGE}:secure-latest"
                echo "✅ Security-verified image pushed!"
            }
        }
        stage('Deploy Hardened Container') {
            steps {
                echo "🚀 Deploying with HIPAA-inspired security controls..."
                sh "sed -i 's|yashraj0409/meditrack:latest|${DOCKER_IMAGE}:${IMAGE_TAG}|g' k8s/deployment-secure.yaml"
                sh "kubectl apply -f k8s/deployment-secure.yaml -n ${NAMESPACE}"
                sh "kubectl rollout status deployment/meditrack-secure -n ${NAMESPACE} --timeout=120s"
            }
        }
        stage('Runtime Security Verify') {
            steps {
                echo "🔒 Verifying runtime security posture..."
                sh """
                    POD=\$(kubectl get pod -n ${NAMESPACE} -l app=meditrack-secure -o jsonpath='{.items[0].metadata.name}')
                    echo "Pod: \$POD"
                    WHOAMI=\$(kubectl exec \$POD -n ${NAMESPACE} -- whoami 2>/dev/null || echo 'unknown')
                    echo "Running as: \$WHOAMI"
                    if [ "\$WHOAMI" = "root" ]; then
                        echo "❌ FAIL: Running as root!"
                        exit 1
                    else
                        echo "✅ PASS: Non-root confirmed: \$WHOAMI"
                    fi
                    kubectl exec \$POD -n ${NAMESPACE} -- node -e "require('http').get('http://localhost:3000/health',(r)=>{console.log('Health:',r.statusCode);process.exit(r.statusCode===200?0:1)})"
                    echo "✅ PASS: Health check passed"
                    kubectl get pods -n ${NAMESPACE}
                """
            }
        }
    }
    post {
        always {
            echo "📊 Security reports saved in security-reports/"
        }
        success {
            echo """
🏆 DevSecOps Pipeline COMPLETE!
✅ Dependency audit: DONE
✅ Container CVE scan: PASSED
✅ Security gate: PASSED
✅ Non-root deployment: VERIFIED
✅ MediTrack HMS is secure and live!
            """
        }
        failure {
            echo "❌ DevSecOps failed. Patient data NOT protected. Do NOT deploy."
        }
    }
}
